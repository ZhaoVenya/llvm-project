    {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Debug llc for DayCore",
                "type": "cppdbg",
                "request": "launch",
                "program": "${workspaceFolder}/build/bin/llc",
                "args": [
                    "-march=riscv32",
                    "-O0",
                    "-filetype=asm",
                    // "-print-before=asm-printer",
                    "${workspaceFolder}/day_test_doc/src/aaa.ll",
                    "-o",
                    "-",
                    "--debug"
                ],
                "stopAtEntry": false,
                "cwd": "${workspaceFolder}",
                "environment": [],
                "externalConsole": false,
                "MIMode": "gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ]
            }
        ]
    }
