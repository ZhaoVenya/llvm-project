        {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "opt RISCV GPU",
                "type": "cppdbg",
                "request": "launch",
                "program": "${workspaceFolder}/build/bin/opt",
                "args": [
                    "-mtriple=riscv64-unknown-unknown",
                    "-riscv-gpu-div",
                    "-S",
                    // "-print-before=asm-printer",
                    "${workspaceFolder}/day_test_doc/src/kernel.ll",
                    "-o",
                    // "-",
                    "${workspaceFolder}/day_test_doc/src/kernel_div.ll",
                    "-debug",
                    // "--asm-show-inst"
                ],
                "stopAtEntry": false,
                "cwd": "${workspaceFolder}",
                "environment": [],
                "externalConsole": false,
                "MIMode": "gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ]
            }
        ]
    }